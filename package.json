{
  "name": "rendermd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:start": "supabase start && scripts/db-migrate.sh local",
    "db:test": "supabase test db",
    "test:e2e": "scripts/playwright-docker.sh --project=chromium",
    "test:e2e:stored": "scripts/e2e-stored.sh",
    "test:visual": "scripts/playwright-docker.sh --project=visual",
    "db:reset": "supabase db reset && scripts/db-migrate.sh local",
    "db:migrate": "scripts/db-migrate.sh",
    "thumbs": "scripts/playwright-docker.sh --project=thumbs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@mdit/plugin-tex": "^1.1.2",
    "@mermaid-js/mermaid-zenuml": "^1.0.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "downshift": "^9.4.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.4",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0",
    "posthog-js": "^1.438.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dbmate": "^2.36.0",
    "jsdom": "^30.1.2",
    "oxlint": "^1.88.0",
    "supabase": "^2.120.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
